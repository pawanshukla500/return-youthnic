# Return App - Production Environment Configuration Template
# Planned Domain: https://return.youthnic.shop
# NOTE: Never commit production credentials, passwords, or actual API keys.

# Runtime Environment
NODE_ENV=production
PORT=3001

# PostgreSQL Database (TLS CA verification enforced by application)
# Must be a secure connection string with TLS. Never use sslmode=no-verify.
DATABASE_URL=postgresql://username:replace_with_password@hostname:5432/return-scan_youthnic

# Optional: Private CA certificate path if using custom database TLS
# DATABASE_SSL_CA_FILE=/etc/ssl/certs/ca.pem

# CORS & Trusted Origins (comma-separated if multiple)
CORS_ORIGIN=https://return.youthnic.shop

# Resend API Key for Automated Email Reports (Sender: return.scan@youthnic.shop)
# Required for scheduled Daily (8 PM IST) and Weekly (Mon 9 AM IST) operational emails.
RESEND_API_KEY=re_replace_with_resend_api_key

# Shopify Real-Time Integration Database (PostgreSQL - Strictly READ-ONLY)
# External database for live synchronization of Shopify returns & RTOs
SHOPIFY_DATABASE_URL=postgresql://user:password@hostname:5433/shopify?sslmode=verify-full
# SHOPIFY_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Brandfetch Client ID (optional; for channel logos)
BRANDFETCH_CLIENT_ID=

# Required for AES-256-GCM encryption of marketplace supplier credentials.
# Use a unique random value of at least 32 characters.
AUTOMATION_SECRET_KEY=replace_with_unique_random_secret_at_least_32_chars

# OMSGuru Integration (optional; for OMS catalog sync)
OMSGURU_CLIENT_ID=
OMSGURU_CLIENT_SECRET=
OMSGURU_TOKEN=

