# Return App — Automation Engine environment template
#
# Copy to .env and fill in. Never commit the filled file: it holds the engine
# token that protects the supplier browser profiles and the claim queue.

# ---------------------------------------------------------------------------
# Control API binding (required)
# ---------------------------------------------------------------------------
# 0.0.0.0 makes the engine reachable from the desktop client / reverse proxy.
# A non-loopback host makes ENGINE_TOKEN mandatory; the engine refuses to start
# without one. Use 127.0.0.1 only if nothing outside the container talks to it.
ENGINE_HOST=0.0.0.0
ENGINE_PORT=3005

# Bearer token for the control API. Minimum 24 characters.
# Generate one with:  openssl rand -hex 32
ENGINE_TOKEN=

# ---------------------------------------------------------------------------
# Return App backend (required)
# ---------------------------------------------------------------------------
# The engine polls claim jobs and reports progress here. It must be an origin
# this build trusts (the production server, or BACKEND_URL/APP_URL).
BACKEND_URL=https://return.youthnic.shop

# Registered PC / server identity. Leave AGENT_UUID blank on first run and the
# engine generates one and stores it in AGENT_DATA_DIR/config.json.
AGENT_NAME=Return-App-Engine-01
AGENT_UUID=
# Per-PC API key issued by the Return App backend when an Admin or Supervisor
# enrolls this engine. Required before any job can be leased.
AGENT_API_KEY=

# ---------------------------------------------------------------------------
# Browser automation
# ---------------------------------------------------------------------------
BROWSER_MODE=headless
# Leave blank to auto-detect. In the image this is /usr/bin/chromium.
BROWSER_PATH=/usr/bin/chromium
# Chromium runs with its renderer sandbox on. It is only disabled automatically
# when the engine runs as root on Linux, where Chromium refuses to start.
# Set this to 1 ONLY if your container runtime blocks the user namespaces the
# sandbox needs: it lets a compromised supplier page run code as the engine user
# and read the mounted browser profiles and their supplier cookies.
BROWSER_NO_SANDBOX=

# ---------------------------------------------------------------------------
# Worker cadence and storage
# ---------------------------------------------------------------------------
POLL_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MS=15000
LOG_LEVEL=info
# Mounted volume in the container; a real path on a bare-metal systemd install.
AGENT_DATA_DIR=/var/lib/return-app-engine
