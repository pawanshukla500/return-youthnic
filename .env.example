# ==============================================================================
# Return App - Environment Variables Template
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server HTTP Port (default: 3001)
PORT=3001

# Allowed CORS Origins (comma-separated, e.g. https://return.youthnic.shop)
# CORS_ORIGIN=https://return.youthnic.shop

# ------------------------------------------------------------------------------
# Primary Application Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URL with TLS verification:
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_URL=postgresql://user:password@hostname:5432/return-scan_youthnic?sslmode=verify-full

# If self-signed or private CA is used:
# Provide either the CA file path OR the CA certificate content directly
# DATABASE_SSL_CA_FILE=certs/db-ca.pem
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# Shopify Real-Time Integration Database (PostgreSQL - Strictly READ-ONLY)
# ------------------------------------------------------------------------------
# External database URL for live synchronization of Shopify customer returns & RTOs:
# Example: postgresql://USER:PASSWORD@HOST:5433/shopify?sslmode=verify-full
SHOPIFY_DATABASE_URL=postgresql://user:password@hostname:5433/shopify?sslmode=verify-full

# If external Shopify database uses private CA certificate:
# SHOPIFY_SSL_CA_FILE=certs/shopify-ca.pem
# SHOPIFY_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# Sales & Payment Integration Database (PostgreSQL - Strictly READ-ONLY)
# ------------------------------------------------------------------------------
# External database URL for syncing order sales amounts into scanned returns:
# Example: postgresql://USER:PASSWORD@HOST:5432/dashborad?sslmode=verify-full
PAYMENT_DATABASE_URL=postgresql://user:password@hostname:5432/dashborad?sslmode=verify-full

# If external payment database uses private CA certificate:
# PAYMENT_SSL_CA_FILE=certs/payment-ca.pem
# PAYMENT_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# VMS Catalogue Database (PostgreSQL - Strictly READ-ONLY)
# ------------------------------------------------------------------------------
# External database URL for the daily catalogue sync of channel listing SKUs
# and image links into product_master (npm run sync:vms-catalog):
# Example: postgresql://USER:PASSWORD@HOST:5432/vms?sslmode=verify-full
VMS_DATABASE_URL=postgresql://user:password@hostname:5432/vms?sslmode=verify-full

# Pin the VMS server certificate once (stored git-ignored, never committed):
# npm run sync:vms-catalog -- --fetch-ca
# Or point at an existing CA file:
# VMS_SSL_CA_FILE=certs/vms-ca.pem

# ------------------------------------------------------------------------------
# Dedicated Automated Test Database (For 'npm test' integration tests only)
# ------------------------------------------------------------------------------
# Guard: Database name MUST contain 'test' (never production).
# TEST_DATABASE_URL=postgresql://test_user:password@localhost:5432/return_app_test?sslmode=disable

# ------------------------------------------------------------------------------
# Optional 3rd-Party Integrations
# ------------------------------------------------------------------------------
# Required before marketplace portal credentials can be saved or decrypted.
# Use a unique random value of at least 32 characters. Rotating it requires re-entering marketplace passwords.
# AUTOMATION_SECRET_KEY=

# OMSGuru ERP Integration:
# OMSGURU_BASE_URL=https://api.omsguru.com
# OMSGURU_CLIENT_ID=
# OMSGURU_API_TOKEN=

# Resend API Key & Sender Email (for scheduled and automated email operational & discrepancy reports):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=return.scan@youthnic.shop

# Brandfetch Client ID (for marketplace logos and branding):
# BRANDFETCH_CLIENT_ID=

# Firebase Storage Service Account (for long-term 180-day OMSGuru bulk update archiving):
# Either save your service account key file to certs/firebase-service-account.json OR provide as JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"return-scan-app",...}
