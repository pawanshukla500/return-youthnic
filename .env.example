# ==============================================================================
# Return App - Environment Variables Template
# ==============================================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Server HTTP Port (default: 3001)
PORT=3001

# Allowed CORS Origins (comma-separated, e.g. https://return.youthnic.shop)
# CORS_ORIGIN=https://return.youthnic.shop

# ------------------------------------------------------------------------------
# Primary Application Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URL with TLS verification:
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
DATABASE_URL=postgresql://user:password@hostname:5432/return-scan_youthnic?sslmode=verify-full

# If self-signed or private CA is used:
# Provide either the CA file path OR the CA certificate content directly
# DATABASE_SSL_CA_FILE=certs/db-ca.pem
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# Shopify Real-Time Integration Database (PostgreSQL - Strictly READ-ONLY)
# ------------------------------------------------------------------------------
# External database URL for live synchronization of Shopify customer returns & RTOs:
# Example: postgresql://USER:PASSWORD@HOST:5433/shopify?sslmode=verify-full
SHOPIFY_DATABASE_URL=postgresql://user:password@hostname:5433/shopify?sslmode=verify-full

# If external Shopify database uses private CA certificate:
# SHOPIFY_SSL_CA_FILE=certs/shopify-ca.pem
# SHOPIFY_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# Dedicated Automated Test Database (For 'npm test' integration tests only)
# ------------------------------------------------------------------------------
# Guard: Database name MUST contain 'test' (never production).
# TEST_DATABASE_URL=postgresql://test_user:password@localhost:5432/return_app_test?sslmode=disable

# ------------------------------------------------------------------------------
# Optional 3rd-Party Integrations
# ------------------------------------------------------------------------------
# OMSGuru ERP Integration:
# OMSGURU_BASE_URL=https://api.omsguru.com
# OMSGURU_CLIENT_ID=
# OMSGURU_API_TOKEN=

# Resend API Key (for scheduled and automated email discrepancy reports):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Brandfetch Client ID (for marketplace logos and branding):
# BRANDFETCH_CLIENT_ID=
